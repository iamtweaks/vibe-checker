generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Target {
  id            String   @id @default(cuid())
  type          String
  normalizedUrl String
  displayUrl    String
  firstScannedAt DateTime @default(now())
  lastScannedAt  DateTime @default(now())
  scanCount     Int      @default(0)

  scans Scan[]

  @@unique([type, normalizedUrl])
  @@index([type])
  @@index([lastScannedAt])
}

model Scan {
  id             String   @id @default(cuid())
  targetId       String?
  targetUrl      String
  scanType       String
  findingsJson   String
  severityCounts String
  scannedFiles   Int?
  scannedUrls    Int?
  scanDuration   Int?
  createdAt      DateTime @default(now())

  target   Target?       @relation(fields: [targetId], references: [id], onDelete: SetNull)
  findings ScanFinding[]

  @@index([targetId])
  @@index([targetUrl])
  @@index([scanType])
  @@index([createdAt])
}

model ScanFinding {
  id          String   @id @default(cuid())
  scanId      String
  ruleId      String
  severity    String
  title       String
  description String
  filePath    String?
  lineNumber  Int?
  snippet     String?
  remediation String
  createdAt   DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([ruleId])
  @@index([severity])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  tier      String   @default("free")
  createdAt DateTime @default(now())

  apiKeys ApiKey[]
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  keyHash   String   @unique
  createdAt DateTime @default(now())
  lastUsed  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
}
